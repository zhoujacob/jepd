NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Exact origin of this app for Google OAuth redirects.
# Add this origin + /auth/callback to Supabase's allowed redirect URLs.
SITE_URL=http://localhost:3000

# Optional Discord reminders run in Supabase Cron, not Next.js.
# Store discord_session_webhook in Supabase Vault; see docs/DISCORD.md.

# Optional Discord account connections (server-only; never use NEXT_PUBLIC_).
# Register SITE_URL/auth/discord/callback in your Discord application's OAuth2 redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Supabase secret key (sb_secret_...) or legacy service_role key; connection callback only.
SUPABASE_SECRET_KEY=
